# Supabase — get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only required for server-side admin operations (matchmaking cron, etc.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used in OAuth redirects + email confirmations)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
